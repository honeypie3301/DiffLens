# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from project secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional fallback OpenAI-compatible provider (e.g. OpenRouter / Groq / Cerebras):
# GPT_OSS_API_KEY=""
# GPT_OSS_BASE_URL="https://openrouter.ai/api/v1"
# GPT_OSS_MODEL="openai/gpt-oss-120b"
# GROQ_API_KEY=""
# CEREBRAS_API_KEY=""
# OPENROUTER_API_KEY=""
# DEEPSEEK_API_KEY=""
# MISTRAL_API_KEY=""
# OPENAI_API_KEY=""

# Optional: External backend base URL when hosting static frontend on GitHub Pages
# VITE_API_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
